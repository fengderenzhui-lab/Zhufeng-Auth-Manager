# ===========================================================================
# 逐风授权码管理平台 - 环境配置模板
# 复制为 .env 后逐一填写，严禁将真实密钥直接写入本文件或提交到代码库
# ===========================================================================

APP_NAME=逐风授权码管理平台
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
# 生产必须为 HTTPS 域名（如 https://www.example.com）。
# APP_FORCE_HTTPS=true 时应用层兜底强制 HTTPS：API/JSON 请求返回 403 HTTPS_REQUIRED，
# 页面请求 301 跳转 https 同 URL（nginx 层已强制 TLSv1.2/1.3 + HSTS）。
APP_URL=https://www.example.com

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# 数据库（固定 MySQL 8.0+）
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zhufeng_license
DB_USERNAME=zhufeng
DB_PASSWORD=change-me-strong-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# 等保 M-08：生产环境建议启用 DB TLS（配置 CA 证书路径后 PHP 连接自动加密）；
# 留空则明文连接（仅建议内网/隔离环境使用）。证书示例：/etc/ssl/certs/mysql-ca.pem
MYSQL_ATTR_SSL_CA=

# ---------------------------------------------------------------------------
# Docker Compose 专属（docker compose up 时使用，手动部署可忽略）
# MYSQL_ROOT_PASSWORD 为 MySQL 容器 root 密码，必须配置（healthcheck 依赖）
# APP_PORT 为宿主访问端口（默认 8000）
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
APP_PORT=8000

# ---------------------------------------------------------------------------
# Redis（限流 / 防重放 nonce / 会话 / 缓存）
# 等保 M-08 修复：REDIS_PASSWORD 必填（docker compose 强制，留空容器拒绝启动）；
# 手动部署时也务必设置强密码。需与 docker-compose.yml 中 redis 服务保持一致。
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# 初始超级管理员（旧 db:seed 流程使用；新部署请改用 php artisan zf:init-admin 自动生成随机账号）
# ---------------------------------------------------------------------------
LICENSING_INITIAL_ADMIN_EMAIL=admin@example.com
LICENSING_INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 授权码生成
# ---------------------------------------------------------------------------
LICENSING_KEY_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789
LICENSING_KEY_PREFIX=ZF-
LICENSING_MAX_BATCH_SIZE=1000

# ---------------------------------------------------------------------------
# 一机一码 / 设备指纹
# 必填：LICENSING_FINGERPRINT_SALT 为指纹派密钥，泄露会导致指纹可预测
# ---------------------------------------------------------------------------
LICENSING_FINGERPRINT_SALT=change-me-fingerprint-salt
LICENSING_DEFAULT_MAX_DEVICES=1

# ---------------------------------------------------------------------------
# 心跳在线验证（强制在线，无离线宽限）
# interval 应小于 timeout，客户端上报周期取 interval
# ---------------------------------------------------------------------------
LICENSING_HEARTBEAT_INTERVAL=60
LICENSING_HEARTBEAT_TIMEOUT=300
LICENSING_ENFORCE_ONLINE=true
LICENSING_HEARTBEAT_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Ed25519 签名（运行 php artisan license:keys 生成，私钥仅存此处，权限 0600 / 不入库）
# ---------------------------------------------------------------------------
LICENSING_ED25519_PRIVATE_KEY=
LICENSING_ED25519_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# 授权码索引 HMAC 密钥（派生 key_hash 与校验字符；必填，建议 64 位 hex）
# 不配置时回退 APP_KEY（不推荐，APP_KEY 轮换会导致历史授权码全部失效）
# 生成方式：php -r "echo bin2hex(random_bytes(32));"
# ---------------------------------------------------------------------------
LICENSING_KEY_HMAC_SECRET=

# ---------------------------------------------------------------------------
# AES-256-GCM 敏感字段加密（必填：ZF_APP_ENCRYPT_KEY 为 32 字节密钥的 Base64）
# 生成方式：php -r "echo base64_encode(random_bytes(32));"
# 用于加密存储：设备指纹、管理员 HMAC 密钥、授权客户名/邮箱/审计敏感字段等，
#   并派生客户名称 n-gram 盲索引检索密钥（CustomerNgramService）；
#   历史明文数据由迁移自动加密回填
# ---------------------------------------------------------------------------
ZF_APP_ENCRYPT_KEY=

# 等保 ZF-2026-006：密钥轮换期旧密钥（可缺省，32 字节密钥的 Base64）
# 配置后 decrypt 对旧密钥密文自动回退解密（AesGcmService），并可通过
#   reencryptWithCurrentKey 逐步回写为新密文，实现零停机密钥轮换
# ---------------------------------------------------------------------------
ZF_APP_ENCRYPT_KEY_PREV=

# ---------------------------------------------------------------------------
# 随机后台访问路径（默认 admin；部署时改为随机值如 /zf-8k2x9q 以降低后台暴露面）
# 运行 php artisan zf:admin-path 可生成新的随机前缀；修改后需重启生效
# ---------------------------------------------------------------------------
ZF_ADMIN_PATH=admin

# ---------------------------------------------------------------------------
# TLS / HTTPS（nginx 已强制 TLSv1.2/1.3 + HSTS；此处控制应用层强制跳转与响应头）
# APP_FORCE_HTTPS=true 时应用层兜底强制 HTTPS：API/JSON 请求返回 403 HTTPS_REQUIRED，
#   页面请求 301 跳转 https 同 URL；false 用于本地开发 / 纯内网（整体跳过）。
# LICENSING_TRUST_PROXIES=true 时信任反代头 X-Forwarded-Proto（雷池 SafeLine /
#   Cloudflare / CDN 反向代理部署必须为 true，否则反代转发请求会被误判为非 HTTPS）。
# 等保 M-05（v1.31 起）：信任代理改由白名单控制——LICENSING_TRUSTED_PROXIES 为逗号分隔的
#   可信代理 IP 列表（如 1.2.3.4,5.6.7.8）；仅来源 IP 命中白名单才信任 X-Forwarded-Proto，
#   留空表示不信任任何代理头（仅以 isSecure() 判定）。LICENSING_TRUST_PROXIES 已废弃，保留兼容。
# HTTPS_PORT 为 docker compose 对外暴露的 443 映射端口（默认 8443）
# 证书请放入项目根目录 ./certs/tls.crt 与 ./certs/tls.key
# APP_URL 见文件顶部（唯一一处，生产请改为 https://你的域名）
# ---------------------------------------------------------------------------
APP_FORCE_HTTPS=true
LICENSING_TRUST_PROXIES=true
# 等保 M-05：可信代理 IP 白名单（逗号分隔，留空=不信任任何代理头）
LICENSING_TRUSTED_PROXIES=
HTTPS_PORT=8443
LICENSING_HSTS=true

# ---------------------------------------------------------------------------
# 管理端 API 签名（每管理员独立 HMAC secret，登录后下发；true=要求 X-Signature）
# ---------------------------------------------------------------------------
LICENSING_ADMIN_SIGNATURE_REQUIRED=true

# ---------------------------------------------------------------------------
# 客户端对接 /api/licensing/v1（对齐 masterix21/laravel-licensing-client）
# ---------------------------------------------------------------------------
LICENSING_V1_ISSUER=laravel-licensing
LICENSING_V1_TOKEN_TTL_DAYS=7
LICENSING_V1_FORCE_ONLINE_DAYS=14
LICENSING_V1_CLOCK_SKEW=60

# ---------------------------------------------------------------------------
# 登录安全
# ---------------------------------------------------------------------------
# 登录安全（Token 有效期等保二级建议 ≤120 分钟）
LICENSING_TOKEN_TTL_MINUTES=120
LICENSING_MAX_ACTIVE_TOKENS=5
LICENSING_LOCKOUT_THRESHOLD=5
# 等保 M-01 修复：全局锁定阈值（按 email 不区分 IP，防轮换 IP 绕过；IP 维度仍保留）
LICENSING_LOCKOUT_GLOBAL_THRESHOLD=15
LICENSING_LOCKOUT_MINUTES=15
# 等保 H-02 修复：统一密码策略（≥12 位，且含大写/小写/数字/符号至少 3 类）
LICENSING_PASSWORD_MIN_LENGTH=12
LICENSING_PASSWORD_MAX_LENGTH=72
LICENSING_PASSWORD_MIN_CLASSES=3

# ---------------------------------------------------------------------------
# Argon2id 密码哈希（PHP 默认参数，一般无需修改；内存 64MB / 迭代 4 / 并行 4）
# ---------------------------------------------------------------------------
ARGON2_THREADS=4

# ---------------------------------------------------------------------------
# 随机管理员初始化（php artisan zf:init-admin，首次运行输出随机用户名与密码）
# ---------------------------------------------------------------------------
LICENSING_ADMIN_USERNAME_PREFIX=adm_
LICENSING_ADMIN_PASSWORD_LENGTH=18

# ---------------------------------------------------------------------------
# 接口风控
# ---------------------------------------------------------------------------
LICENSING_GLOBAL_RATE_LIMIT=120
LICENSING_LOGIN_RATE_LIMIT_MIN=10
LICENSING_LOGIN_RATE_LIMIT_DAY=50
LICENSING_CLIENT_RATE_LIMIT=60
LICENSING_ADMIN_RATE_LIMIT=300
# 防重放：强制签名 / 时间窗(秒) / nonce 去重缓存时长(秒)
LICENSING_REPLAY_STRICT=true
LICENSING_REPLAY_WINDOW=300
LICENSING_REPLAY_NONCE_TTL=600
# 客户端集成方共用的防重放签名密钥（与授权码密钥无关）
LICENSING_REPLAY_CLIENT_SECRET=change-me-client-secret

# ---------------------------------------------------------------------------
# 安全响应头（LICENSING_HSTS 已在 TLS 段定义，勿重复）
# ---------------------------------------------------------------------------
LICENSING_CSP="default-src 'none'; base-uri 'none'; frame-ancestors 'none'"

# ---------------------------------------------------------------------------
# 审计
# 等保 M-02 修复：LICENSING_AUDIT_HMAC_SECRET 为审计日志哈希链密钥（必填，建议 64 位 hex）。
#   生产环境缺失时应用拒绝启动（fail-closed）；Docker 部署由 entrypoint.sh 自动生成。
# 生成方式：php -r "echo bin2hex(random_bytes(32));"
# ---------------------------------------------------------------------------
LICENSING_AUDIT_HMAC_SECRET=
LICENSING_AUDIT_RETENTION_DAYS=365
LICENSING_AUDIT_HEARTBEAT=false

# ---------------------------------------------------------------------------
# 数据备份（等保 M-03 修复：每日 mysqldump + 保留 N 天，见 docker/backup.sh）
# BACKUP_RETENTION_DAYS 为宿主机 cron 调用 backup.sh 时的保留天数（默认 7）
# ---------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# 雷池（SafeLine）人机验证（V1.32 已实现，默认关闭）
# 开启后 /api/licensing/v1 业务端点与 public-key 校验雷池注入的可信头，缺失/不匹配返回 403 SAFELINE_BLOCKED。
# 开关亦可在设置页「运行参数」维护（settings 表 DB 优先）；endpoint/api_key 为雷池管理接口凭据（仅 .env）。
# ---------------------------------------------------------------------------
LICENSING_SAFELINE_ENABLED=false
LICENSING_SAFELINE_ENDPOINT=
LICENSING_SAFELINE_API_KEY=
LICENSING_SAFELINE_TRUSTED_HEADER=X-SafeLine-Checked

# ---------------------------------------------------------------------------
# 会话 / Cookie
# ---------------------------------------------------------------------------
# 生产 HTTPS 环境必须为 true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
